{
    "name": "ineersa/sqlite-queue",
    "description": "Sqlite based queue broker",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.5",
        "ext-sqlite3": "*",
        "amphp/sync": "^2.3",
        "fabpot/amphp-sqlite3": "^1.0",
        "revolt/event-loop": "^1.0"
    },
    "require-dev": {
        "ext-pcntl": "*",
        "ext-pdo_sqlite": "*",
        "ext-posix": "*",
        "doctrine/dbal": "^4.3",
        "friendsofphp/php-cs-fixer": "^3.95",
        "jolicode/castor": "^1.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^13.2",
        "symfony/console": "^8.0",
        "symfony/doctrine-messenger": "^8.0",
        "symfony/event-dispatcher": "^8.0",
        "symfony/messenger": "^8.0",
        "symfony/process": "^8.0"
    },
    "suggest": {
        "symfony/messenger": "Required to use the Symfony Messenger transport adapter."
    },
    "autoload": {
        "psr-4": {
            "Ineersa\\SqliteQueue\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ineersa\\SqliteQueue\\Bench\\": "bench/src/",
            "Ineersa\\SqliteQueue\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Illia Vasylevskyi",
            "email": "ineersa@gmail.com"
        }
    ],
    "config": {
        "sort-packages": true
    }
}
